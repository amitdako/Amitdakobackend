# Copy this file to `.env` and adjust values. `.env` is gitignored.
#   cp .env.example .env

# Prisma / SQLite connection. Path is relative to the prisma/ directory.
DATABASE_URL="file:./data.db"

# Secrets used to sign JWTs. Use long, random, DISTINCT values in any real
# environment. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-insecure-secret-replace-me-0123456789abcdef0123456789abcdef"
REFRESH_TOKEN_SECRET="dev-only-insecure-refresh-secret-replace-me-abcdef0123456789abcdef01"

# Set to "production" to enable Secure cookies (requires HTTPS). Leave as
# development for local http://localhost work.
NODE_ENV="development"

# Port the API listens on (matches the frontend's API_URL in src/api.ts).
PORT=3001

# The only browser origin allowed by CORS (the Vite dev server).
FRONTEND_ORIGIN="http://localhost:5173"

# Demo user passwords, read ONLY by the seed script (server/src/seed.ts).
# The database stores only the bcrypt hash. The seed THROWS if any is missing.
# These are local demo defaults — change them for any real use.
SEED_ADMIN_PASSWORD="Admin!2026"
SEED_ANALYST_PASSWORD="Analyst!2026"
SEED_VIEWER_PASSWORD="Viewer!2026"
