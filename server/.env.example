# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Prisma / SQLite connection. Path is relative to the prisma/ directory.
DATABASE_URL="file:./data.db"

# Secret used to sign JWTs. Use a long, random value in any real environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Port the API listens on (matches the frontend's API_URL in src/api.ts).
PORT=3001

# The only browser origin allowed by CORS (the Vite dev server).
FRONTEND_ORIGIN="http://localhost:5173"
